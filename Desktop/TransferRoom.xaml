<UserControl x:Class="PersonalDownloader.Desktop.TransferRoom"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#101923" Foreground="#EEF5F7" FontFamily="Segoe UI">
 <Viewbox Stretch="Uniform">
  <Grid Width="1180" Height="597" Background="#101923">
   <Canvas>
    <Canvas.Resources>
     <Style x:Key="Pin" TargetType="TextBlock"><Setter Property="Background" Value="#ED182632"/>
      <Setter Property="Padding" Value="8,4"/><Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    </Canvas.Resources>
    <TextBlock x:Name="Title" Canvas.Left="26" Canvas.Top="16" Width="840" TextTrimming="CharacterEllipsis" FontSize="32" FontWeight="SemiBold"/>
    <TextBlock x:Name="Source" Canvas.Left="27" Canvas.Top="62" Width="800" TextTrimming="CharacterEllipsis" Foreground="#AEC1CD" FontSize="15"/>
    <Border Canvas.Right="24" Canvas.Top="26" Background="#22362F" CornerRadius="17" Padding="17,6">
     <TextBlock x:Name="Phase" FontSize="16" Foreground="#BFF773" FontWeight="SemiBold"/>
    </Border>
    <ContentControl x:Name="HardwareHost" Canvas.Left="16" Canvas.Top="104"/>
    <Path Data="M123,170 L151,170 172,191 M632,221 L632,251 596,293" Stroke="#CCDAE1"/>
    <Path Data="M437,171 L437,222 407,282" Stroke="#BFF773"/>
    <Path Data="M342,415 L368,415 377,378" Stroke="#65D6FF"/>

    <TextBlock Canvas.Left="35" Canvas.Top="157" Style="{StaticResource Pin}" Text="File server"/>
    <TextBlock x:Name="Pin0" Canvas.Left="397" Canvas.Top="147" MaxWidth="220" Style="{StaticResource Pin}" Foreground="#BFF773"/>
    <TextBlock x:Name="Pin1" Canvas.Left="208" Canvas.Top="405" MaxWidth="252" Style="{StaticResource Pin}" Foreground="#65D6FF"/>
    <Path Data="M526,373 L514,351 466,332" Stroke="#A89274"/>
    <TextBlock x:Name="Pin2" Canvas.Left="506" Canvas.Top="370" MaxWidth="245" Style="{StaticResource Pin}"/>
    <TextBlock Canvas.Left="583" Canvas.Top="199" Style="{StaticResource Pin}" Text="Local drive"/>
    <Border Canvas.Left="774" Canvas.Top="94" Width="390" Height="357" Background="#192632" Padding="20,13" CornerRadius="10">
     <StackPanel><TextBlock Text="Saved file ranges" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="Waiting" Text="Waiting for transfer data" Foreground="#AEC1CD"/>
      <StackPanel x:Name="RangesPanel"/>
     </StackPanel>
    </Border>
    <Border Canvas.Left="16" Canvas.Top="464" Width="1148" Height="117" Background="#1C2A36" CornerRadius="10"/>
    <TextBlock x:Name="DiskTitle" Canvas.Left="37" Canvas.Top="479" MaxWidth="750" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock x:Name="Amount" Canvas.Right="40" Canvas.Top="481" FontSize="17" FontFamily="Consolas" FontWeight="SemiBold"/>
    <UniformGrid x:Name="FileParts" Canvas.Left="38" Canvas.Top="516" Width="1105" Rows="1"/>
   </Canvas>
  </Grid>
 </Viewbox>
</UserControl>
